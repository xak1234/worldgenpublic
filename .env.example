# WorldGen environment. Copy to .env for local runs; set as platform env vars in production.
# Empty values are treated as unset.
#
# SECRETS (set these yourself; never commit them):
#   WORLDGEN_API_KEY    admin key (x-api-key header): world building, media pipelines,
#                       uploads, deletes. Required when NODE_ENV=production.
#                       Players use their character id + 3-digit PIN for gameplay.
#   LLM (at least one):  MISTRAL_API_KEY  CEREBRAS_API_KEY  GEMINI_API_KEY  OPENAI_API_KEY
#                        ANTHROPIC_API_KEY  NVIDIA_API_KEY  RELAY_API_KEY
#   Script digests:      DEEPSEEK_API_KEY
#   Cast + covers:       TMDB_API_KEY
#   Images:              POLLINATIONS_API_KEY  TOGETHER_API_KEY  FAL_API_KEY  IMAGE_GEN_API_KEY
#   Soundscapes:         SOMA_API (Freesound)

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3002
# NODE_ENV: leave out of .env for local dev. Docker/Render set NODE_ENV=production, which
# refuses to start without WORLDGEN_API_KEY. (An empty NODE_ENV= line here would unset it.)
# true = anyone may create a character on a keyed instance
WORLDGEN_PUBLIC_SIGNUP=
# Comma-separated extra origins for CORS + WebSocket (same-origin is always allowed)
CORS_ORIGINS=http://localhost:3002
# Proxy hop count when behind Render / nginx / Caddy (usually 1)
TRUST_PROXY=
# true = block delete/reset/baseline routes (shared demo instance)
DISABLE_DESTRUCTIVE_WRITES=

# ── Storage ──────────────────────────────────────────────────────────────────
# Worlds, sessions, players.json, debug dumps. Absolute, or relative to the repo.
WORLDGEN_DATA_DIR=
# Boot-time load budgets (MB). Anything skipped is indexed and loaded on first use.
# 0 for worlds = load all.
WORLDGEN_WORLD_LOAD_BUDGET_MB=0
WORLDGEN_SESSION_LOAD_BUDGET_MB=48
WORLDGEN_MAX_SESSION_FILE_MB=4
WORLDGEN_LOAD_SESSIONS=1
# Startup pruning caps (newest N kept)
WORLDGEN_KEEP_FAILED_JSON=200
WORLDGEN_KEEP_DIALOGUE_DEBUG=500
WORLDGEN_KEEP_BUILD_CHECKPOINTS=40
WORLDGEN_KEEP_IMG_CACHE=2000
# 1 = write every NPC prompt to DATA_DIR/dialogue-debug (dev only)
DIALOGUE_DEBUG=

# ── LLM routing ──────────────────────────────────────────────────────────────
# deepseek | mistral | cerebras | gemini | openai | anthropic | nvidia | relay | lmstudio
LLM_PROVIDER=mistral
LLM_PROVIDER_COOLDOWN_MS=120000
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_MODEL=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible gateway, with or without the trailing /v1. For OmniRoute:
#   LLM_PROVIDER=openai, OPENAI_BASE_URL=http://127.0.0.1:20128/v1, OPENAI_MODEL=<id from its /v1/models>
#   and put the gateway's key in OPENAI_GATEWAY_API_KEY. It is used before OPENAI_API_KEY, so a
#   machine-wide OpenAI key cannot be sent to the gateway by mistake.
# To switch off a provider whose key is also set machine-wide, leave its line empty here (e.g. a bare
# MISTRAL key line with nothing after the =): the server removes variables that .env sets to empty.
OPENAI_BASE_URL=
OPENAI_GATEWAY_API_KEY=
ANTHROPIC_MODEL=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
RELAY_MODEL=
RELAY_BASE_URL=
LMSTUDIO_MODEL=
LMSTUDIO_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek is a dialogue provider too (LLM_PROVIDER=deepseek). Its models reason before answering;
# that is off for game calls so short replies are not left empty. enabled = reason first.
DEEPSEEK_THINKING=
# NPC voices (Mistral TTS; falls back to browser TTS without a Mistral key)
VOICE_PROVIDER=mistral
VOICE_MODEL=
# Speech engine: mistral (Voxtral, needs a Mistral key) | chatterbox (local service, see
# voice_service/README.md) | browser (built-in browser voices only)
VOICE_TTS_BACKEND=
# chatterbox: service URL, and optionally an SSH host to reach its loopback port through
CHATTERBOX_TTS_URL=
CHATTERBOX_SSH_HOST=

# ── Media ────────────────────────────────────────────────────────────────────
# 1 = never generate new images (only the files already in public/generated are served)
WORLDGEN_DISABLE_IMAGE_GEN=
# The lobby lists only worlds whose cover, portraits and scenes all load. 1 = list every world.
WORLDGEN_SHOW_INCOMPLETE_WORLDS=
# Image generation cascade: together → fal → pollinations unless IMAGE_GEN_PROVIDERS is set
IMAGE_GEN_PROVIDERS=
IMAGE_GEN_PROVIDER=pollinations
IMAGE_GEN_BASE_URL=
TOGETHER_IMAGE_MODEL=
FAL_IMAGE_MODEL=

# ── Optional Python pipelines (portrait ArcFace, sound packs) ────────────────
# Interpreter for scripts/*.py (default: python3 on Linux, python on Windows)
PYTHON_BIN=
PORTRAIT_PYTHON=
# World builder child-process retries
WORLDGEN_BUILD_RETRY_COUNT=3
WORLDGEN_BUILD_RETRY_DELAY_SECS=5
